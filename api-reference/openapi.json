              "example": {
                "name": "ACME Perú",
                "country": "PE",
                "industry": "Tecnología",
                "status": "active",
                "employees": "11-50"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Account"
